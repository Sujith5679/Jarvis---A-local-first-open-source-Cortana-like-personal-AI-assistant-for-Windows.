# =========================
# LLM PROVIDERS
# =========================

GROQ_API_KEY=
GROQ_MODEL=

OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=

# Optional future local Ollama
OLLAMA_LOCAL_BASE_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=

# Optional: Deepgram, a second cloud voice provider (see VOICE section below).
DEEPGRAM_API_KEY=

# =========================
# WEB
# =========================

# SearXNG's own default port is 8888 (not 8080) — see README for setup.
SEARXNG_URL=http://127.0.0.1:8888
# Optional: let JARVIS start/stop its own local SearXNG process instead of
# you running it separately every time. Requires SearXNG already set up per
# the README (a checkout with its own venv) — SEARXNG_DIR is the path to
# that checkout, e.g. C:\Users\you\searxng. Off by default.
SEARXNG_AUTOSTART=false
SEARXNG_DIR=

# =========================
# USER
# =========================

JARVIS_USER_NAME=
JARVIS_USER_EMAIL=
JARVIS_TIMEZONE=Asia/Kolkata

# =========================
# APPLICATION
# =========================

JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=
# Off by default (spec.md §27: "Do not force automatic startup"). Toggle via
# Settings -> "Start JARVIS with Windows" instead of editing this directly -
# that's what actually registers/removes the Task Scheduler entry; this
# value only seeds the checkbox the very first time Settings opens.
JARVIS_START_ON_BOOT=false
JARVIS_HOTKEY=ctrl+space
JARVIS_START_MINIMIZED=true
JARVIS_ENABLE_VOICE=true
JARVIS_ENABLE_WAKE_WORD=false
# Cross-encoder reranking pass over search_files results (rag/reranker.py).
# On by default; turn off to skip loading the ~80MB reranker model if you
# want a lighter/faster (but less precise) file search.
JARVIS_ENABLE_RERANKER=true

# =========================
# VOICE
# =========================

# Ordered, comma-separated provider chain, tried in order. "local" is
# always attempted as a final safety net even if omitted. See README.
JARVIS_STT_PROVIDERS=groq,deepgram,local
JARVIS_TTS_PROVIDERS=groq,deepgram,local
# Optional: override the local Piper voice model path (see README).
JARVIS_PIPER_VOICE_PATH=

# =========================
# FUTURE GOOGLE
# =========================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
