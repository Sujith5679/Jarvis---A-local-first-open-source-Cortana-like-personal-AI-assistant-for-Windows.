# ==============================================================================
# JARVIS Configuration Template (.env.example)
#
# Copy this file to .env and configure your keys:
#   copy .env.example .env
# ==============================================================================

# =========================
# LLM PROVIDERS
# =========================

# Primary LLM provider (Groq). Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
# Optional: Model override. Default: openai/gpt-oss-120b
# GROQ_MODEL="openai/gpt-oss-120b"

# Fallback cloud provider (Ollama Cloud). Optional; used if Groq hits rate limits or fails.
# OLLAMA_CLOUD_API_KEY="your_ollama_cloud_api_key_here"
# OLLAMA_CLOUD_MODEL="gpt-oss:120b"

# Optional local Ollama instance (privacy/offline mode)
# OLLAMA_LOCAL_BASE_URL=http://localhost:11434
# OLLAMA_LOCAL_MODEL="llama3.2"

# Optional: Deepgram cloud STT/TTS provider (https://console.deepgram.com)
# DEEPGRAM_API_KEY="your_deepgram_api_key_here"

# =========================
# WEB SEARCH (SearXNG)
# =========================

# SearXNG local instance URL (default port 8888 per README instructions)
SEARXNG_URL=http://127.0.0.1:8888

# Optional: Let JARVIS automatically start/stop SearXNG subprocess with the app.
# Requires SearXNG checked out with its own virtualenv (see README.md).
SEARXNG_AUTOSTART=false
# SEARXNG_DIR=C:\Users\you\searxng

# =========================
# USER PREFERENCES
# =========================

# Optional: Personalize assistant greetings and system prompts
# JARVIS_USER_NAME="User"
# JARVIS_USER_EMAIL="user@example.com"
JARVIS_TIMEZONE=Asia/Kolkata

# =========================
# APPLICATION
# =========================

JARVIS_LOG_LEVEL=INFO
# Optional: Custom data directory for SQLite DB, logs, vector indexes (defaults to ./data)
# JARVIS_DATA_DIR=C:\path\to\custom\data

# Start JARVIS automatically on Windows boot (toggle in Settings UI)
JARVIS_START_ON_BOOT=false
JARVIS_HOTKEY=ctrl+space
JARVIS_START_MINIMIZED=true
JARVIS_ENABLE_VOICE=true
JARVIS_ENABLE_WAKE_WORD=false

# Cross-encoder reranking pass over search_files results (rag/reranker.py).
# Set false to skip loading the ~80MB local reranker model for lighter memory usage.
JARVIS_ENABLE_RERANKER=true

# =========================
# VOICE (STT & TTS)
# =========================

# Ordered, comma-separated provider chain tried in order ("local" is always final fallback)
JARVIS_STT_PROVIDERS=groq,deepgram,local
JARVIS_TTS_PROVIDERS=groq,deepgram,local

# Optional: Custom local Piper voice model path (.onnx file)
# JARVIS_PIPER_VOICE_PATH=C:\path\to\voice.onnx

# =========================
# GOOGLE INTEGRATION (Future)
# =========================

# GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your_client_secret"
# GOOGLE_REDIRECT_URI="http://localhost:8080/oauth2callback"
